<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- For the tray icon (I4): WPF has no equivalent of NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sirs.App</RootNamespace>
    <AssemblyName>SIRS</AssemblyName>
    <!-- Phase 4 of the roadmap. The update check compares against this. -->
    <Version>1.3.0</Version>
    <Product>SIRS — Simple Internet Radio Streamer</Product>
    <Description>A Windows live audio encoder for Icecast and SHOUTcast.</Description>
    <Copyright>Copyright (C) 2026 SIRS contributors. Licensed under GPL-3.0-or-later.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFAC010 asks for DPI to be set through the WinForms project property. This is a WPF app that
      only borrows WinForms for the tray icon, so the manifest stays the source of truth.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIRS.Core\SIRS.Core.csproj" />
  </ItemGroup>

</Project>
