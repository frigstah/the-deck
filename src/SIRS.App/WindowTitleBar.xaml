<UserControl x:Class="Sirs.App.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">

    <!--
        The title bar for SIRS's other windows. The main window draws its own, because its caption
        has the rail running through it; everything else looks like this: the window's name at the
        left, a close button at the right, and the window's own background in between so the caption
        does not read as a separate band.

        The title is taken from the window rather than set here, so it can only ever say what the
        taskbar and Alt-Tab say.
    -->
    <Grid Background="Transparent">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                   TextTrimming="CharacterEllipsis" />

        <!-- Buttons have to opt out of the caption, or Windows treats a click on them as a click on
             the title bar and starts dragging the window instead. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimiseButton" Content="&#xE921;" Click="OnMinimise"
                    Style="{StaticResource CaptionButtonStyle}"
                    AutomationProperties.Name="Minimise" ToolTip="Minimise" />
            <Button x:Name="MaximiseButton" Content="&#xE922;" Click="OnMaximiseOrRestore"
                    Style="{StaticResource CaptionButtonStyle}"
                    AutomationProperties.Name="Maximise" ToolTip="Maximise" />
            <Button x:Name="CloseButton" Content="&#xE8BB;" Click="OnClose"
                    Style="{StaticResource CaptionCloseButtonStyle}"
                    AutomationProperties.Name="Close" ToolTip="Close" />
        </StackPanel>
    </Grid>
</UserControl>
