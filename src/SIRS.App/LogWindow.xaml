<Window x:Class="Sirs.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirs.App"
        xmlns:diag="clr-namespace:Sirs.Core.Diagnostics;assembly=SIRS.Core"
        Title="Session log"
        Height="560" Width="760" MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:WindowTitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HintStyle}" Margin="0,0,0,12"
                   Text="What SIRS has done this session. A copy is saved to a file each day, so you can look back at a show that misbehaved." />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4">
            <ListBox x:Name="EntryList" ItemsSource="{Binding LogEntries}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,3" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type diag:LogEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Top"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                       VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <CheckBox x:Name="FollowTail" Content="Keep scrolling to the newest" IsChecked="True"
                      VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy all" Click="OnCopyAll" MinWidth="100" />
                <Button Content="Open log folder" Click="OnOpenFolder" Margin="8,0,0,0" MinWidth="130" />
                <Button Content="Close" Click="OnClose" Margin="8,0,0,0" MinWidth="90" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
