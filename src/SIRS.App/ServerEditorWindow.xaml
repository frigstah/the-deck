<Window x:Class="Sirs.App.ServerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirs.App"
        Title="Server settings"
        Height="800" Width="820" MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:TextToVisibilityConverter x:Key="TextToVisibility" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="InverseBoolean" />
        <local:ServerTypeNameConverter x:Key="ServerTypeName" />
        <local:CodecNameConverter x:Key="CodecName" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:WindowTitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- Paste a URL: the fastest path through this whole window -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="START HERE" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,0,0,8"
                                   Text="Paste whatever your host sent you — a stream link, or the whole email with the server, port and password in it. SIRS will fill in what it can." />

                        <TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="88"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Fill in the details" Click="OnApplyPaste"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding PasteFeedback}" Style="{StaticResource HintStyle}"
                                   Foreground="{Binding PasteFeedbackBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding PasteFeedback, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Connection details -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Style="{StaticResource SectionHeadingStyle}" />

                        <TextBlock Text="Name this server" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Who hosts your stream?" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding HostPresets}" SelectedItem="{Binding SelectedHostPreset}"
                                  ItemTemplate="{StaticResource NameItemTemplate}" />
                        <TextBlock Text="{Binding HostGuidance}" Style="{StaticResource HintStyle}" Margin="0,6,0,0"
                                   Visibility="{Binding HostGuidance, Converter={StaticResource TextToVisibility}}" />
                        <TextBlock Text="{Binding HostFieldNaming}" Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                                   Visibility="{Binding HostFieldNaming, Converter={StaticResource TextToVisibility}}" />

                        <TextBlock Text="Server type" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding ServerTypes}" SelectedItem="{Binding ServerTypeValue}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ServerTypeName}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                                   Text="Leave this on “Detect automatically” unless your host told you otherwise — pressing Test will work it out." />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Server address" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Use a secure connection (https)" IsChecked="{Binding UseTls}" Margin="0,10,0,0" />

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowMountPoint, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StreamPathLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MountPoint, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding StreamPathHint}" Style="{StaticResource HintStyle}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowStreamId, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StreamPathLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding StreamId, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                     HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding StreamPathHint}" Style="{StaticResource HintStyle}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                                       Text="Almost always “source”. Only change it if your host said to." />
                        </StackPanel>

                        <TextBlock Text="Broadcast password" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordField" PasswordChanged="OnPasswordChanged" />
                            <TextBox x:Name="PasswordPlain" Visibility="Collapsed"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" x:Name="ShowPasswordButton" Content="Show" Width="70"
                                    Margin="8,0,0,0" Click="OnTogglePasswordVisibility" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                                   Text="Stored encrypted on this computer, for your Windows account only." />
                    </StackPanel>
                </Border>

                <!-- Quality -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="QUALITY" Style="{StaticResource SectionHeadingStyle}" />

                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                  ItemTemplate="{StaticResource NameItemTemplate}" />
                        <TextBlock Text="{Binding QualityDescription}" Style="{StaticResource HintStyle}" Margin="0,6,0,0" />

                        <CheckBox Content="Show the individual settings" IsChecked="{Binding ShowAdvanced}" Margin="0,12,0,0" />

                        <Grid Margin="0,12,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Format" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource CodecName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <!-- Hidden for FLAC: lossless has no bitrate to choose. -->
                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding ShowBitrate, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Bitrate (kbps)" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding BitrateKbps}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Sample rate" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                <CheckBox Content="Stereo" IsChecked="{Binding IsStereo}" Margin="0,0,0,7" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding CodecBlurb}" Style="{StaticResource HintStyle}" Margin="0,10,0,0"
                                   Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding LosslessNote}" Style="{StaticResource HintStyle}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource WarnBrush}"
                                   Visibility="{Binding LosslessNote, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Public listing -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="WHAT LISTENERS SEE" Style="{StaticResource SectionHeadingStyle}" />

                        <TextBlock Text="Station name" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Genre" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Website" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="List my station in public directories" IsChecked="{Binding ListInDirectory}"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Test -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="TEST" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,0,0,10"
                                   Text="SIRS connects, signs in and sends a couple of seconds of silence, so you know it works before you are on air." />

                        <Button Content="Test connection" Click="OnTest" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolean}}" />

                        <ItemsControl ItemsSource="{Binding TestSteps}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}"
                                                   FontWeight="Bold" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" MinWidth="170" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding TestSummary}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{Binding TestSummaryBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding TestSummary, Converter={StaticResource TextToVisibility}}" />
                        <TextBlock Text="{Binding TestAdvice}" Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                                   Visibility="{Binding TestAdvice, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" MinWidth="100" />
            <Button Content="Save" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="120" Margin="8,0,0,0" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
