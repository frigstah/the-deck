<Window x:Class="Sirs.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sirs.App"
        Title="Welcome to SIRS"
        Height="620" Width="720" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:TextToVisibilityConverter x:Key="TextToVisibility" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:WindowTitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="StepSubtitle" Style="{StaticResource HintStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- Step 1: input -->
            <Border x:Name="Step1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="What are you broadcasting?" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding InputDevicesView}" SelectedItem="{Binding SelectedInput}"
                                  ItemTemplate="{StaticResource DeviceItemTemplate}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="DeviceGroupStyle" />
                            </ComboBox.GroupStyle>
                        </ComboBox>
                        <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Click="OnRefreshDevices" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,6,0,0"
                               Text="Pick a microphone to talk, or the sound this PC is playing to broadcast music from any app." />

                    <TextBlock Text="{Binding InputSourceHint}" Style="{StaticResource HintStyle}" Margin="0,6,0,0"
                               Visibility="{Binding InputSourceHint, Converter={StaticResource TextToVisibility}}" />

                    <TextBlock Text="Now make some sound and watch the bar."
                               Style="{StaticResource HintStyle}" Margin="0,16,0,8" />

                    <local:LevelMeterControl Height="44"
                                             PeakDbLeft="{Binding PeakDbLeft}"
                                             PeakDbRight="{Binding PeakDbRight}"
                                             HoldDb="{Binding WindowPeakDb}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Level" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="-24" Maximum="24" Margin="10,0,0,0"
                                Value="{Binding InputGainDb, Delay=40}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Ellipse Width="12" Height="12" Fill="{Binding AdviceBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AdviceHeadline}" Margin="8,0,0,0" FontWeight="SemiBold"
                                   Foreground="{Binding AdviceBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AdviceHint}" Style="{StaticResource HintStyle}" Margin="20,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Step 2: sound check -->
            <Border x:Name="Step2" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,0,0,14"
                               Text="Record a few seconds and play it back. This is the only way to know you sound the way you think you do." />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding SoundCheckButtonText}" Command="{Binding SoundCheckCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="160" />
                        <Button Content="{Binding SoundCheckPlayText}" Command="{Binding PlaySoundCheckCommand}"
                                IsEnabled="{Binding CanPlaySoundCheck}" Margin="8,0,0,0" MinWidth="130" />
                    </StackPanel>

                    <ProgressBar Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding SoundCheckProgress, Mode=OneWay}"
                                 Visibility="{Binding IsSoundCheckRecording, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding SoundCheckStatus}" Style="{StaticResource HintStyle}"
                               Foreground="{Binding SoundCheckBrush}" Margin="0,14,0,0" />

                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,18,0,0"
                               Text="Playback uses your headphones or speakers, not the broadcast — nothing goes out yet." />
                </StackPanel>
            </Border>

            <!-- Step 3: server -->
            <Border x:Name="Step3" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,0,0,14"
                               Text="Your host gave you a server address, a port and a password. Add them here — you can paste the whole email and SIRS will pick out what it needs." />

                    <Button Content="Add a server…" Click="OnAddServer" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" MinWidth="180" />

                    <TextBlock Text="{Binding SelectedServerSummary}" Style="{StaticResource HintStyle}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding QualitySummary}" Style="{StaticResource HintStyle}" Margin="0,4,0,0" />

                    <TextBlock x:Name="ServerSkipHint" Style="{StaticResource HintStyle}" Margin="0,18,0,0"
                               Text="You can skip this and add a server later — SIRS still records perfectly well without one." />
                </StackPanel>
            </Border>

            <!-- Step 4: done -->
            <Border x:Name="Step4" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="That is everything." FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,10,0,0"
                               Text="Press Go live on the main window when you are ready. If anything goes wrong, SIRS will tell you what to fix in plain words rather than an error code." />
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,14,0,0"
                               Text="A few things worth knowing:" />
                    <TextBlock Style="{StaticResource HintStyle}" Margin="12,8,0,0"
                               Text="• Test connection in the server settings checks everything before you are on air." />
                    <TextBlock Style="{StaticResource HintStyle}" Margin="12,4,0,0"
                               Text="• If the connection drops, SIRS reconnects on its own within a second." />
                    <TextBlock Style="{StaticResource HintStyle}" Margin="12,4,0,0"
                               Text="• Turn on headphones monitoring to hear exactly what is going out." />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="StepCounter" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="Skip setup" Click="OnSkip" MinWidth="110" />
                <Button x:Name="BackButton" Content="Back" Click="OnBack" MinWidth="90" Margin="8,0,0,0" />
                <Button x:Name="NextButton" Content="Next" Click="OnNext" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="120" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
