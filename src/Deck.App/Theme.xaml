<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Palette. App.xaml.cs overwrites every one of these at startup to follow the Windows theme
        (I5), so the two sets have to stay in step - a colour added here and forgotten there shows
        up as one stubbornly light element on a dark window.

        The accent is a petrol teal rather than the usual UI blue. It is the colour of instrument
        panelling, it does not compete with the on-air red the way a saturated blue does, and it
        leaves red free to mean exactly one thing.

        Neutrals are warm-biased on light and slate-biased on dark. A pure grey reads as unchosen.
    -->
    <Color x:Key="BackgroundColor">#FFFBFBFA</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#FFE3E3DF</Color>
    <Color x:Key="TextColor">#FF1B1F23</Color>
    <Color x:Key="MutedTextColor">#FF71787E</Color>
    <Color x:Key="AccentColor">#FF2A6A70</Color>
    <!-- Text drawn on top of the accent. Flips to near-black on the dark theme, where
         the accent is lightened and white would drop to about 2:1. -->
    <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
    <Color x:Key="OkColor">#FF1F6E4C</Color>
    <Color x:Key="WarnColor">#FF8A5B12</Color>
    <Color x:Key="BadColor">#FFC93F36</Color>
    <Color x:Key="LiveColor">#FFC93F36</Color>

    <!-- Soft fills behind the verdict pills. Tinted from the semantic colour rather than grey, so
         a verdict reads at a glance without shouting. -->
    <Color x:Key="OkSoftColor">#FFE4F1EA</Color>
    <Color x:Key="WarnSoftColor">#FFF6ECD9</Color>
    <Color x:Key="BadSoftColor">#FFF6E3E1</Color>
    <Color x:Key="NeutralSoftColor">#FFECECE8</Color>

    <!-- The rail and the status strip. Both keep their own colours in either theme, because they
         are chrome rather than content. -->
    <Color x:Key="RailColor">#FF1D2226</Color>
    <Color x:Key="RailSelectedColor">#FF262D33</Color>
    <Color x:Key="RailTextColor">#FF7E8890</Color>
    <Color x:Key="StatusBarColor">#FFF4F4F1</Color>

    <!-- Hover behind a caption button. A wash of the window's own text colour rather than a fixed
         grey, so it stays a hint on either theme instead of a slab on one of them. -->
    <Color x:Key="CaptionHoverColor">#18000000</Color>
    <Color x:Key="CaptionPressedColor">#30000000</Color>

    <!-- Meter segments, lit and unlit. Held as resources rather than baked into the control so the
         meter follows the theme like everything else. -->
    <Color x:Key="MeterQuietColor">#FF9AA5A2</Color>
    <Color x:Key="MeterGoodColor">#FF3F9E76</Color>
    <Color x:Key="MeterLoudColor">#FFD7A64A</Color>
    <Color x:Key="MeterClipColor">#FFC9564C</Color>
    <Color x:Key="MeterQuietOffColor">#FFDCDCD6</Color>
    <Color x:Key="MeterGoodOffColor">#FFC3DCD0</Color>
    <Color x:Key="MeterLoudOffColor">#FFE8D6B4</Color>
    <Color x:Key="MeterClipOffColor">#FFE9CDC9</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{DynamicResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{DynamicResource BadColor}" />
    <SolidColorBrush x:Key="LiveBrush" Color="{DynamicResource LiveColor}" />

    <SolidColorBrush x:Key="OkSoftBrush" Color="{DynamicResource OkSoftColor}" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{DynamicResource WarnSoftColor}" />
    <SolidColorBrush x:Key="BadSoftBrush" Color="{DynamicResource BadSoftColor}" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="{DynamicResource NeutralSoftColor}" />

    <SolidColorBrush x:Key="StatusBarBrush" Color="{DynamicResource StatusBarColor}" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="{DynamicResource CaptionHoverColor}" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="{DynamicResource CaptionPressedColor}" />

    <!-- Close is the one caption button that keeps Windows' own colours. Nobody needs to learn where
         the red one is, and a station being taken off air by a misclick is worth one borrowed
         convention. Both stay fixed across themes, as they do everywhere else in Windows. -->
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#FFCF5A4E" />

    <SolidColorBrush x:Key="MeterQuietBrush" Color="{DynamicResource MeterQuietColor}" />
    <SolidColorBrush x:Key="MeterGoodBrush" Color="{DynamicResource MeterGoodColor}" />
    <SolidColorBrush x:Key="MeterLoudBrush" Color="{DynamicResource MeterLoudColor}" />
    <SolidColorBrush x:Key="MeterClipBrush" Color="{DynamicResource MeterClipColor}" />
    <SolidColorBrush x:Key="MeterQuietOffBrush" Color="{DynamicResource MeterQuietOffColor}" />
    <SolidColorBrush x:Key="MeterGoodOffBrush" Color="{DynamicResource MeterGoodOffColor}" />
    <SolidColorBrush x:Key="MeterLoudOffBrush" Color="{DynamicResource MeterLoudOffColor}" />
    <SolidColorBrush x:Key="MeterClipOffBrush" Color="{DynamicResource MeterClipOffColor}" />

    <!--
        The custom ComboBox template below draws the selected item through a ContentPresenter, which
        does not apply DisplayMemberPath. Every picker therefore states its template explicitly
        rather than relying on the item's ToString.
    -->
    <DataTemplate x:Key="DeviceItemTemplate">
        <TextBlock Text="{Binding DisplayName}" />
    </DataTemplate>

    <DataTemplate x:Key="NameItemTemplate">
        <TextBlock Text="{Binding Name}" />
    </DataTemplate>

    <!-- Section heading inside a grouped picker, e.g. "Sound playing on this PC". -->
    <GroupStyle x:Key="DeviceGroupStyle">
        <GroupStyle.HeaderTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="10,8,10,3" />
            </DataTemplate>
        </GroupStyle.HeaderTemplate>
    </GroupStyle>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="HintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    </Style>

    <!--
        The stock ComboBox template hard-codes its own chrome, so a dark palette leaves light text
        on a light box. This replaces just enough of the template to make it follow the theme.
    -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="0">
                                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource MutedTextBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selection" IsHitTestVisible="False"
                                          Margin="10,0,26,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{DynamicResource TextBrush}" />

                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="0" Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Selection" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The big on-air control. Deliberately the largest thing on the screen. -->
    <Style x:Key="GoLiveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ============================================================== the rail

         The navigation rail is a TabControl underneath. That is the control that already means
         "one of these at a time", so it brings keyboard navigation, focus handling and screen
         reader semantics with it (I6) - all of which would have to be rebuilt by hand if the rail
         were a stack of buttons driving a visibility flag.
    -->

    <SolidColorBrush x:Key="RailBrush" Color="{DynamicResource RailColor}" />
    <SolidColorBrush x:Key="RailSelectedBrush" Color="{DynamicResource RailSelectedColor}" />
    <SolidColorBrush x:Key="RailTextBrush" Color="{DynamicResource RailTextColor}" />

    <!--
        The width of the rail, shared rather than repeated. The window's own title bar puts a block
        of rail colour above the rail so the two read as one column running to the top of the window,
        and that block has to be exactly this wide. Two hand-tuned numbers that must agree is one
        number waiting to be changed in only one place.
    -->
    <sys:Double x:Key="RailWidth">78</sys:Double>

    <Style x:Key="RailItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource RailTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Background="Transparent" BorderThickness="2,0,0,0"
                            BorderBrush="Transparent" Padding="0,9"
                            Width="{StaticResource RailWidth}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="17"
                                       HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                            <!-- Mono, uppercase, letter-spaced: rail labels are signage, not prose. -->
                            <TextBlock Text="{TemplateBinding Header}" FontSize="9.5"
                                       FontFamily="Consolas" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RailSelectedBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <!-- Keyboard focus has to be visible, not just hover (I6). -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RailTabControlStyle" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- The wordmark used to sit here. It now lives in the title bar directly
                             above, which is the same block of rail colour - so it reads as the top
                             of this column rather than as a separate header. -->
                        <Border Background="{DynamicResource RailBrush}">
                            <StackPanel IsItemsHost="True" />
                        </Border>

                        <!--
                            The name is not decoration. TabControl looks up exactly this name to
                            find its content host, and its automation peer publishes the selected
                            pane's contents only if it found one. Without the name the rail reported
                            seven tabs and nothing inside any of them - every picker, slider and
                            button on every pane was invisible to a screen reader (I6).
                        -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The window's own caption buttons, drawn because the Windows ones cannot be recoloured and a
        light system title bar above a dark window is the single most obvious seam in the product.

        Sized 46x40 rather than to taste. That is what Windows uses, and the muscle memory for
        "close" lives in a corner of a particular size; making it smaller to look neater would cost
        more than it gains. The glyphs come from the system icon font for the same reason - they are
        the shapes users already read as minimise, maximise and close.
    -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                        </Trigger>
                        <!-- Reachable and visibly so from the keyboard, like every other control
                             in the window (I6). -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionClosePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The wordmark, sitting in the title bar over the rail. -->
    <Style x:Key="WordmarkStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="Deck" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Heading at the top of a pane. Larger than the old card headings, because there is now one
         of them per screen rather than six. -->
    <Style x:Key="PaneHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!--
        Micro-label: mono, uppercase, letter-spaced, muted. Every field label and group heading in
        the window uses it.

        Small caps in a monospace face reads as instrument legending rather than as a form, which is
        the difference between a control surface and a settings dialog. WPF has no letter-spacing
        property, so the spacing is baked into the strings themselves - see the window, where labels
        are written with the spaces in.
    -->
    <Style x:Key="MicroLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="GroupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource MicroLabelStyle}">
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <!-- A number, anywhere. Tabular so digits do not shuffle sideways as they change. -->
    <Style x:Key="ReadoutStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The verdict pill. The only rounded thing in the window, which is what makes it read as a
         badge rather than as another control. -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Status strip along the bottom. Present on every pane, which is the whole point: you can be
         deep in the recording settings and still see that you are on air. -->
    <!--
        A switch, for the settings that are a state rather than a list of things ticked. Built on
        CheckBox rather than as a control of its own, so it keeps the toggle semantics a screen reader
        already understands (I6) - it announces as something with an on and an off, which is exactly
        what it is.

        Square track, square thumb. Every switch in every other program is a rounded capsule, and one
        here would be the second rounded thing on screen after the verdict pill, which is the one
        shape that is supposed to be unique.
    -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="38" Height="20" VerticalAlignment="Center"
                                Background="{DynamicResource NeutralSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Border x:Name="Thumb" Width="14" Height="14"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource MutedTextBrush}" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- Focus has to be visible, not just hover (I6). -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusChipStyle" TargetType="TextBlock" BasedOn="{StaticResource ReadoutStyle}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,0,18,0" />
    </Style>

    <Style x:Key="StatusValueStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Square, outlined, quiet. Used for Stop, which should never be an inviting target. -->
    <Style x:Key="StripButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,5" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
