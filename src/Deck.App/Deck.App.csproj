<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- For the tray icon (I4): WPF has no equivalent of NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Deck.App</RootNamespace>
    <AssemblyName>Deck</AssemblyName>
    <!--
      First release under this name. The engine arrived at 1.3.0 as SIRS, but "The Deck 1.3.0"
      would imply a 1.0, 1.1 and 1.2 that never existed under this name - so the product starts at
      1.0.0 while the shared history stays in the repository. The update check compares against this.
    -->
    <Version>1.0.0</Version>
    <Product>The Deck — live radio broadcaster</Product>
    <Description>A Windows live audio encoder for Icecast and SHOUTcast.</Description>
    <Copyright>Copyright (C) 2026 Deck contributors. Licensed under GPL-3.0-or-later.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFAC010 asks for DPI to be set through the WinForms project property. This is a WPF app that
      only borrows WinForms for the tray icon, so the manifest stays the source of truth.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deck.Core\Deck.Core.csproj" />
  </ItemGroup>

</Project>
