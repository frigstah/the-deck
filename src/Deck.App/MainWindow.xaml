<Window x:Class="Deck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Deck.App"
        Title="The Deck"
        Height="482" Width="1020" MinHeight="460" MinWidth="820"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        The default size above is deliberately short. The deck is an instrument panel, not a
        document: it holds five rows and then it is finished, so a taller window would add nothing
        but emptiness underneath. At this height it parks along the top or bottom of a screen and
        leaves the rest to whatever is playing the music, which is how it will actually be used.

        Setup opens over the top of it at the same size and its panes scroll, so the compact default
        costs a little scrolling in the place you visit rarely rather than a screenful of nothing in
        the place you look at all night.
    -->

    <!--
        The window draws its own title bar. Windows will not let an application colour the system
        one, so a dark Deck sat under a light caption with a light Deck under a dark one - whichever
        way round, a visible seam across the top of the product.

        CaptionHeight is what makes the top strip behave like a title bar: dragging moves the window
        and a double-click maximises it, both handled by Windows rather than reimplemented here.
        Anything that needs to be clicked inside that strip has to opt out with
        WindowChrome.IsHitTestVisibleInChrome.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--
        The "Rail" layout: a navigation rail down the left, one subject in the pane beside it, and a
        status strip along the bottom that is present on every pane.

        The strip is the reason this layout was chosen. The old window put the on-air state in a
        header that scrolled with everything else, so the answer to "am I still live?" depended on
        where you happened to be scrolled to. Here it cannot leave the screen.
    -->

    <Window.Resources>
        <local:TextToVisibilityConverter x:Key="TextToVisibility" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True" />
        <local:InverseBooleanConverter x:Key="InverseBoolean" />

        <Style x:Key="RuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Margin" Value="0,22,0,18" />
        </Style>

        <Style x:Key="PaneScrollStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="26,22,26,26" />
        </Style>

        <!--
            Panes are a single readable column, not a full-width sprawl.

            The width is taken from the scroller's viewport rather than left to the content. A
            left-aligned StackPanel is only as wide as its widest child, and on the Sound pane the
            widest child is usually the coaching sentence under the meter - which rewrites itself as
            you speak. "Nothing is reaching Deck..." wraps to the full 620; "Your level is in the
            right range." does not. The meter stretches to the column, so it was changing width by
            around 200 pixels every time the verdict changed: it visibly breathed with the audio it
            was supposed to be measuring. Anchoring the column to the viewport makes the width a
            property of the window, which is the only thing it should ever have depended on.
        -->
        <Style x:Key="PaneBodyStyle" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="620" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width"
                    Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================================================== title bar

             Two halves. The left is a block of rail colour exactly the width of the rail, so the
             rail appears to run to the very top of the window and the wordmark sits at the head of
             it. The right is the window's own background, so the caption simply is the pane: no
             line, no band, nothing to notice. All that is left of a title bar is three buttons. -->
        <Grid Grid.Row="0" Height="40"
              Visibility="{Binding ShowFullTitleBar, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Rail-coloured only while the rail is there to continue it. The block exists so the
                rail appears to run to the very top of the window with the wordmark at its head - but
                on the deck there is no rail, and the light theme made that obvious in a way the dark
                one had hidden: a black rectangle in the top-left corner with nothing underneath it.
                On the deck it is simply part of the window.
            -->
            <Border Width="{StaticResource RailWidth}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSetupOpen}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RailBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock>
                    <TextBlock.Style>
                        <!-- White reads on the rail; on the window it would be invisible on light and
                             too loud on dark, so off the rail it takes the window's own text colour. -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WordmarkStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSetupOpen}" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- The buttons have to opt out of the caption, or Windows treats a click on them as a
                 click on the title bar and starts dragging the window instead. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimiseButton" Content="&#xE921;" Click="OnMinimiseWindow"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.Name="Minimise" ToolTip="Minimise" />
                <Button x:Name="MaximiseButton" Content="&#xE922;" Click="OnMaximiseOrRestoreWindow"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.Name="Maximise" ToolTip="Maximise" />
                <Button x:Name="CloseButton" Content="&#xE8BB;" Click="OnCloseWindow"
                        Style="{StaticResource CaptionCloseButtonStyle}"
                        AutomationProperties.Name="Close" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!-- ==================================================== the content area

             Two things occupy it, one at a time: the deck, and setup over the top of it.

             ClipToBounds because setup slides: without it the panel is drawn over the title bar and
             the status strip on its way past them. -->
        <Grid Grid.Row="1" ClipToBounds="True">

            <!-- ================================================ THE DECK

                 The meter is the interface. Four things, top to bottom: whether you are on air and
                 for how long; what you sound like; what the signal path is; and what listeners are
                 seeing. No settings, no tabs, nothing to scroll.

                 Laid out as a grid rather than a stack so the meter block takes the space that is
                 left after the fixed rows, and therefore grows with the window instead of leaving a
                 gap under it. -->
            <Grid Margin="34,26,34,24"
                  Visibility="{Binding ShowDeck, Converter={StaticResource BoolToVisibility}}">
                <!--
                    The slack lives in exactly one place: the row above the footer. An earlier
                    version gave the meter a star row and capped its height, which put half the
                    spare height above the meter and half below it — the deck read as three things
                    adrift in a large dark rectangle rather than as one instrument. Concentrating
                    the gap below the controls keeps the top block tight and pins the footer to the
                    bottom edge, which is where a footer belongs.
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- state and elapsed time -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Ellipse Style="{StaticResource DeckLampStyle}" Fill="{Binding StateBrush}" />
                        <TextBlock Text="{Binding StateHeadlineUpper}" Style="{StaticResource DeckStateStyle}" />
                    </StackPanel>

                    <!-- Only while there is something to time. A clock reading 0:00 off air is a
                         number pretending to be information. -->
                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource DeckClockStyle}"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- the meter, and what it means -->
                <Grid Grid.Row="1" Margin="0,26,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- A fixed height, not a share of the window. Tall enough to read across a
                         room, and the same size every time so the eye learns where the segments
                         sit rather than re-reading the scale after every resize. -->
                    <local:LevelMeterControl Grid.Row="0" Height="104"
                                             PeakDbLeft="{Binding PeakDbLeft}"
                                             PeakDbRight="{Binding PeakDbRight}"
                                             HoldDb="{Binding WindowPeakDb}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="{Binding AdviceHeadline}" Style="{StaticResource DeckVerdictStyle}"
                                   Foreground="{Binding AdviceBrush}"
                                   Visibility="{Binding ShowLevelCoaching, Converter={StaticResource BoolToVisibility}}" />
                        <!-- First in the row, so no leading gap of its own: the verdict before it
                             carries that, and the row has to start flush when the verdict is off. -->
                        <TextBlock Text="{Binding LevelReadout}" Style="{StaticResource DeckReadoutStyle}"
                                   Margin="0,0,0,1" />
                        <TextBlock Text="{Binding IntegratedLoudnessText}" Style="{StaticResource DeckReadoutStyle}" />
                        <!-- The hover carries where the number came from, or why there is not one. The
                             readout has room for "no listener count" and not for the reason. -->
                        <TextBlock Text="{Binding ListenerText}" Style="{StaticResource DeckReadoutStyle}"
                                   ToolTip="{Binding ListenerTooltip}"
                                   Visibility="{Binding ListenerText, Converter={StaticResource TextToVisibility}}" />
                        <TextBlock Text="{Binding CorrelationSummary}" Style="{StaticResource DeckReadoutStyle}"
                                   Visibility="{Binding CorrelationSummary, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- the signal path, and the only two controls on the deck -->
                <Grid Grid.Row="2" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Chips wrap rather than clip: a long server name on a narrow window should
                         drop to a second line, not vanish behind the buttons. -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!--
                            The input, changeable in place. Same picker the Sound pane uses, same
                            grouping into microphones and loopback sources - so swapping between a
                            venue's desk feed and a laptop microphone is one click from the deck.

                            It says which input, but shortened: Windows names an endpoint "IN 1-8
                            (BEHRINGER X-AIR)" and the part before the bracket is both what a person
                            would say out loud and a third of the length. Left whole, this chip alone
                            decided the width of the row. The full name is in the tooltip, in the list,
                            and on the Sound pane.

                            Every chip below is one control: the chip and the picker are the same
                            element, so all of it is the click target and the popup needs no help
                            finding its edges. Tag is the caption, ValueText is the answer.
                        -->
                        <ComboBox Style="{StaticResource DeckChipComboStyle}" Tag="Input"
                                  local:DeckChip.ValueText="{Binding InputChipShort}"
                                  ItemsSource="{Binding InputDevicesView}"
                                  SelectedItem="{Binding SelectedInput}"
                                  ItemTemplate="{StaticResource DeviceItemTemplate}"
                                  IsEnabled="{Binding CanChangeSignalPath}"
                                  AutomationProperties.Name="Input"
                                  ToolTip="{Binding InputChipTooltip}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="DeviceGroupStyle" />
                            </ComboBox.GroupStyle>
                        </ComboBox>

                        <!--
                            The destination, changeable in place. This is the one a singer moving
                            between venues reaches for most: each venue has its own stream, and
                            without this every change meant opening setup and finding the Servers pane.
                        -->
                        <ComboBox Style="{StaticResource DeckChipComboStyle}" Tag="Server"
                                  local:DeckChip.ValueText="{Binding SelectedServerShort}"
                                  ItemsSource="{Binding Servers}"
                                  SelectedItem="{Binding SelectedServer}"
                                  ItemTemplate="{StaticResource NameItemTemplate}"
                                  MaxWidth="200"
                                  IsEnabled="{Binding CanChangeSignalPath}"
                                  AutomationProperties.Name="Server"
                                  ToolTip="{Binding ServerChipTooltip}" />

                        <!--
                            Quality: the handful of bitrates anyone picks between, rather than the full
                            range that lives in the server editor. Bitrate only - sample rate is set
                            once per server and then left alone, so it belongs in the editor and not on
                            a surface meant for the things you change between songs.

                            Hidden rather than empty before a server exists, and while the codec is
                            lossless, since FLAC has no bitrate to choose.
                        -->
                        <ComboBox Style="{StaticResource DeckChipComboStyle}" Tag="Quality"
                                  local:DeckChip.ValueText="{Binding SelectedQualityOption}"
                                  Visibility="{Binding CanChangeQuality, Converter={StaticResource BoolToVisibility}}"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQualityOption}"
                                  IsEnabled="{Binding CanChangeSignalPath}"
                                  AutomationProperties.Name="Quality"
                                  ToolTip="{Binding QualityChipTooltip}" />

                        <!-- Lossless states the codec and nothing else, since there is nothing to pick. -->
                        <Border Style="{StaticResource DeckChipStyle}"
                                Visibility="{Binding ShowLosslessChip, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding QualityShort}" Style="{StaticResource DeckChipValueStyle}"
                                       ToolTip="{Binding QualitySummary}" />
                        </Border>

                        <!--
                             Record is a button, not a chip. It sits at the end of the chip row
                             because that is where the mockup drew it and it belongs with the signal
                             path - but everything to its left is a fact and this is a control, so it
                             is shaped like one and it works.
                        -->
                        <Button Content="{Binding RecordButtonLabel}" Click="OnToggleRecording"
                                Style="{StaticResource DeckRecordButtonStyle}"
                                ToolTip="{Binding RecordButtonTooltip}"
                                AutomationProperties.Name="Record" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- The other direction from Setup: not more of Deck, but less of it. Next to
                             Setup because both are about what is on screen rather than about the show. -->
                        <Button Content="Mini" Click="OnEnterMiniMode"
                                Style="{StaticResource DeckSetupButtonStyle}" Margin="0,0,12,0"
                                ToolTip="Shrink to a thin strip that stays on top of your other windows." />

                        <Button Content="Setup" Command="{Binding OpenSetupCommand}"
                                Style="{StaticResource DeckSetupButtonStyle}" Margin="0,0,12,0"
                                ToolTip="Everything that is not the show." />

                        <!-- Outlined while live, filled while off air. Going on air should be an
                             inviting target; taking a station off air should not be something the
                             hand finds by accident. -->
                        <Button Content="{Binding GoLiveButtonText}" Click="OnToggleBroadcast"
                                Style="{StaticResource DeckActionButtonStyle}"
                                Background="{Binding GoLiveButtonBrush}"
                                Foreground="{Binding GoLiveButtonTextBrush}"
                                BorderBrush="{Binding GoLiveButtonBorderBrush}" />
                    </StackPanel>
                </Grid>

                <!-- what listeners are seeing, and how the connection is holding -->
                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <Border Style="{StaticResource RuleStyle}" Margin="0,0,0,14" VerticalAlignment="Top" />

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="NOW PLAYING&#160;&#160;" Style="{StaticResource DeckFooterStyle}" />
                            <TextBlock Text="{Binding NowPlayingLine}" Style="{StaticResource DeckFooterStyle}"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <!-- Dead air is the loudest thing the deck can say, so it takes the
                                 colour and sits where the eye already is. -->
                            <TextBlock Text="{Binding SilenceAlert}" Style="{StaticResource DeckFooterStyle}"
                                       Foreground="{DynamicResource BadBrush}" FontWeight="Bold"
                                       Margin="0,0,18,0"
                                       Visibility="{Binding SilenceAlert, Converter={StaticResource TextToVisibility}}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource DeckFooterStyle}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,0,18,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}" />
                            <TextBlock Text="{Binding BufferText}" Style="{StaticResource DeckFooterStyle}"
                                       Margin="0,0,18,0"
                                       Visibility="{Binding BufferText, Converter={StaticResource TextToVisibility}}" />
                            <TextBlock Text="{Binding SentText}" Style="{StaticResource DeckFooterStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================================================ THE STRIP

                 Mini mode. Four things and nothing else: whether you are on air, what it sounds
                 like, where it is going, and the button that stops it.

                 What is missing is the point. No input picker - you do not change interface
                 mid-song. No quality, no now-playing, no listener count, no way to reach a setting.
                 If you need any of those you need the deck, and the deck is one press away.

                 The strip is also the window's title bar while it is the whole window: dragging the
                 state block, the meter or the space around them moves it, and a double-click on them
                 puts the deck back. Only the controls opt out of the caption, or there would be
                 nothing left to drag the window by. -->
            <Border x:Name="MiniStrip" Padding="12,0"
                    Background="{DynamicResource BackgroundBrush}"
                    Visibility="{Binding IsMiniMode, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Same square block as the status strip, so "am I live?" is answered by the
                         same shape and colour wherever Deck happens to be showing it. -->
                    <Border Grid.Column="0" Background="{Binding StateBrush}" Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateHeadlineUpper}" Foreground="White"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding UptimeText}"
                               Style="{StaticResource StatusValueStyle}" Margin="12,0,0,0"
                               Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Short, and no scale: at this height the numbers under it would be unreadable,
                         and the zone colours are what the meter is for at a glance. -->
                    <local:LevelMeterControl Grid.Column="2" Height="20" Margin="16,0,16,0"
                                             VerticalAlignment="Center" ShowScale="False"
                                             PeakDbLeft="{Binding PeakDbLeft}"
                                             PeakDbRight="{Binding PeakDbRight}"
                                             HoldDb="{Binding WindowPeakDb}" />

                    <!-- Dead air is the one thing the strip must never be too small to say. -->
                    <TextBlock Grid.Column="3" Text="{Binding SilenceAlert}"
                               Foreground="{DynamicResource BadBrush}"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding SilenceAlert, Converter={StaticResource TextToVisibility}}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- The one picker worth keeping: a singer moving between venues changes
                             where the sound goes far more often than anything else. -->
                        <ComboBox Style="{StaticResource DeckChipComboStyle}" Tag="Server"
                                  local:DeckChip.ValueText="{Binding SelectedServerShort}"
                                  ItemsSource="{Binding Servers}"
                                  SelectedItem="{Binding SelectedServer}"
                                  ItemTemplate="{StaticResource NameItemTemplate}"
                                  MaxWidth="170"
                                  IsEnabled="{Binding CanChangeSignalPath}"
                                  AutomationProperties.Name="Server"
                                  ToolTip="{Binding ServerChipTooltip}" />

                        <Button Content="{Binding RecordButtonLabel}" Click="OnToggleRecording"
                                Style="{StaticResource DeckRecordButtonStyle}"
                                ToolTip="{Binding RecordButtonTooltip}"
                                AutomationProperties.Name="Record" />

                        <Button Content="{Binding GoLiveButtonText}" Click="OnToggleBroadcast"
                                Style="{StaticResource StripButtonStyle}" MinWidth="130"
                                Margin="10,0,0,0"
                                Background="{Binding GoLiveButtonBrush}"
                                Foreground="{Binding GoLiveButtonTextBrush}"
                                BorderBrush="{Binding GoLiveButtonBorderBrush}" />

                        <Button Content="Deck" Click="OnLeaveMiniMode" Margin="10,0,0,0"
                                Style="{StaticResource StripButtonStyle}"
                                AutomationProperties.Name="Full deck"
                                ToolTip="Back to the whole deck." />

                        <Button x:Name="MiniMinimiseButton" Content="&#xE921;" Click="OnMinimiseWindow"
                                Style="{StaticResource CaptionButtonStyle}" Margin="8,0,0,0"
                                AutomationProperties.Name="Minimise" ToolTip="Minimise" />
                        <Button x:Name="MiniCloseButton" Content="&#xE8BB;" Click="OnCloseWindow"
                                Style="{StaticResource CaptionCloseButtonStyle}"
                                AutomationProperties.Name="Close" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================ SETUP, over the top

                 Opaque and full-height, so it is unmistakably a different mode rather than a panel
                 that appeared. The status strip below stays visible while it is open, which is what
                 lets you change a setting mid-show without losing sight of being on air. -->
            <!--
                Visibility and the offset are both driven from code rather than bound, because the
                panel slides and a bound Visibility would snap it away mid-animation. See
                MainWindow.xaml.cs: the distance it travels is its own ActualHeight, read at the
                moment it moves, so it is right at any window size.
            -->
            <Border x:Name="SetupPanel" Background="{DynamicResource BackgroundBrush}"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SetupOffset" Y="0" />
                </Border.RenderTransform>
                <Grid>
                    <!--
                        No header row. It held the word SETUP and a close button, and both were
                        wrong: the rail already says which pane you are on, and the way back belongs
                        in the strip along the bottom with the other things you press. Removing it
                        gave the rail the ~50 pixels it needed to show all seven entries in a window
                        this short, which is the difference between a rail you scroll and one you
                        just read.
                    -->
                    <TabControl
                                Style="{StaticResource RailTabControlStyle}"
                                ItemContainerStyle="{StaticResource RailItemStyle}"
                                SelectedIndex="{Binding SelectedSection}">

            <!-- ==================================================== 1. SOUND -->
            <TabItem Header="Sound" Tag="◉">
                <ScrollViewer Style="{StaticResource PaneScrollStyle}">
                    <StackPanel Style="{StaticResource PaneBodyStyle}">

                        <TextBlock Text="Sound" Style="{StaticResource PaneHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,4"
                                   Text="What goes into the stream, and how it sounds before anything else touches it." />

                        <!-- I N P U T -->
                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,14,0,0">
                            <TextBlock Text="I N P U T" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Input" ContentWidth="330"
                                              Hint="A microphone, the sound this PC is playing, or a professional interface.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding InputDevicesView}"
                                              SelectedItem="{Binding SelectedInput}"
                                              ItemTemplate="{StaticResource DeviceItemTemplate}"
                                              AutomationProperties.Name="Input device">
                                        <ComboBox.GroupStyle>
                                            <StaticResource ResourceKey="DeviceGroupStyle" />
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="Refresh" Click="OnRefreshDevices"
                                            Style="{StaticResource RowButtonStyle}"
                                            ToolTip="Look for devices you have just plugged in." />
                                </Grid>
                            </local:SettingRow>

                            <local:SettingRow Label="Which inputs" ContentWidth="330"
                                              Hint="{Binding InputChannelHint}"
                                              Visibility="{Binding ShowInputChannels, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox ItemsSource="{Binding InputChannelOptions}"
                                          SelectedItem="{Binding SelectedInputChannelLabel}"
                                          AutomationProperties.Name="Which inputs feed the stream" />
                            </local:SettingRow>

                            <!-- Full width and loud, because it means audio is not arriving. -->
                            <Border Background="{DynamicResource WarnBrush}" Padding="12,9" Margin="0,12,0,0"
                                    Visibility="{Binding WaitingForDevice, Converter={StaticResource TextToVisibility}}">
                                <TextBlock Text="{Binding WaitingForDevice}" Foreground="White" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding InputSourceHint}" Style="{StaticResource HintStyle}"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding InputSourceHint, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>

                        <!-- L E V E L -->
                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="L E V E L" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Input level" ContentWidth="300" ShowRule="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-24" Maximum="24" TickFrequency="6"
                                            Value="{Binding InputGainDb, Delay=40}"
                                            IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                            AutomationProperties.Name="Input level in decibels" />
                                    <TextBlock Grid.Column="1" Text="{Binding InputGainText}" Width="62"
                                               TextAlignment="Right" FontFamily="Consolas" />
                                </Grid>
                            </local:SettingRow>

                            <!--
                                A slim meter, not the deck's. The deck carries the full-size one, but
                                setup covers the deck - and setting a gain without seeing what it does
                                is guesswork. So the control and its feedback stay together, at the
                                smallest size that still answers "is that too hot?".
                            -->
                            <local:LevelMeterControl Height="16" Margin="0,2,0,0" ShowScale="False"
                                                     PeakDbLeft="{Binding PeakDbLeft}"
                                                     PeakDbRight="{Binding PeakDbRight}"
                                                     HoldDb="{Binding WindowPeakDb}" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <!-- The gap belongs to the pill, not to the readout. Put it on the
                                     readout instead and hiding the pill leaves the number indented
                                     against nothing. -->
                                <Border Style="{StaticResource PillStyle}" Background="{Binding AdvicePillBrush}"
                                        Margin="0,0,12,0"
                                        Visibility="{Binding ShowLevelCoaching, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding AdviceHeadlineUpper}"
                                               Style="{StaticResource PillTextStyle}"
                                               Foreground="{Binding AdviceBrush}" />
                                </Border>
                                <TextBlock Text="{Binding LevelReadout}" Style="{StaticResource ReadoutStyle}" />
                                <TextBlock Text="{Binding CorrelationSummary}" Style="{StaticResource ReadoutStyle}"
                                           Margin="12,0,0,0"
                                           Visibility="{Binding CorrelationSummary, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding AdviceHint}" Style="{StaticResource HintStyle}" Margin="0,8,0,4"
                                       Visibility="{Binding ShowLevelCoaching, Converter={StaticResource BoolToVisibility}}" />

                            <local:SettingRow Label="Level coaching" ContentWidth="38"
                                              Hint="{Binding LevelCoachingHint}">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ShowLevelCoaching}"
                                          AutomationProperties.Name="Level coaching" />
                            </local:SettingRow>

                            <local:SettingRow Label="Voice Enhance" ContentWidth="38"
                                              Hint="Steadier level and less rumble, for speech.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding VoiceEnhance}"
                                          AutomationProperties.Name="Voice Enhance" />
                            </local:SettingRow>

                            <local:SettingRow Label="Automatic level" ContentWidth="38" ShowRule="False"
                                              Hint="Slowly corrects if you drift closer to the microphone or further away.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AutoGain}"
                                          AutomationProperties.Name="Automatic level" />
                            </local:SettingRow>
                        </StackPanel>

                        <!-- S O U N D   C H E C K -->
                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="S O U N D   C H E C K" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Hear yourself" ContentWidth="290" ShowRule="False"
                                              Hint="Records ten seconds and plays it straight back, the way listeners will hear it.">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding SoundCheckButtonText}"
                                            Command="{Binding SoundCheckCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" />
                                    <Button Content="{Binding SoundCheckPlayText}"
                                            Command="{Binding PlaySoundCheckCommand}"
                                            IsEnabled="{Binding CanPlaySoundCheck}"
                                            Style="{StaticResource RowButtonStyle}" MinWidth="110" />
                                </StackPanel>
                            </local:SettingRow>

                            <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                         Value="{Binding SoundCheckProgress, Mode=OneWay}"
                                         Visibility="{Binding IsSoundCheckRecording, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding SoundCheckStatus}" Style="{StaticResource HintStyle}"
                                       Foreground="{Binding SoundCheckBrush}" Margin="0,10,0,0"
                                       Visibility="{Binding SoundCheckStatus, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>

                        <!-- H E A D P H O N E S -->
                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="H E A D P H O N E S" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Listen while I broadcast" ContentWidth="38">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding MonitorEnabled}"
                                          AutomationProperties.Name="Listen while I broadcast" />
                            </local:SettingRow>

                            <local:SettingRow Label="Output" ContentWidth="330">
                                <ComboBox ItemsSource="{Binding MonitorDevices}"
                                          SelectedItem="{Binding SelectedMonitorDevice}"
                                          ItemTemplate="{StaticResource DeviceItemTemplate}"
                                          AutomationProperties.Name="Headphone output device" />
                            </local:SettingRow>

                            <local:SettingRow Label="Volume" ContentWidth="300" ShowRule="False">
                                <Slider Minimum="0" Maximum="1" Value="{Binding MonitorVolume, Delay=40}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Headphone volume" />
                            </local:SettingRow>

                            <TextBlock Text="{Binding MonitorWarning}" Style="{StaticResource HintStyle}"
                                       Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0"
                                       Visibility="{Binding MonitorWarning, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>

                        <!-- S E C O N D   S O U R C E -->
                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,22,0,8">
                            <TextBlock Text="S E C O N D   S O U R C E" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Add a second source" ContentWidth="38"
                                              ShowRule="{Binding SecondarySourceEnabled}"
                                              Hint="Play music from any app underneath your microphone, or talk over a guest.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding SecondarySourceEnabled}"
                                          AutomationProperties.Name="Add a second sound source" />
                            </local:SettingRow>

                            <StackPanel Visibility="{Binding SecondarySourceEnabled, Converter={StaticResource BoolToVisibility}}">
                                <local:SettingRow Label="Second input" ContentWidth="330" ShowRule="False">
                                    <ComboBox ItemsSource="{Binding InputDevicesView}"
                                              SelectedItem="{Binding SelectedSecondaryInput}"
                                              ItemTemplate="{StaticResource DeviceItemTemplate}"
                                              AutomationProperties.Name="Second sound source">
                                        <ComboBox.GroupStyle>
                                            <StaticResource ResourceKey="DeviceGroupStyle" />
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                </local:SettingRow>

                                <!--
                                    Not a row. Two faders with their own meters and mutes is genuinely
                                    a table - label, control, control, per source - and forcing it into
                                    the row language would misrepresent it. This is the one place in
                                    setup that stays a grid, because it is the one place that is a mixer.
                                -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PrimaryFaderLabel}"
                                               Width="112" TextTrimming="CharacterEllipsis" />
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-40" Maximum="12" Margin="8,0,8,0"
                                            Value="{Binding PrimaryGainDb, Delay=40}" VerticalAlignment="Center"
                                            AutomationProperties.Name="Main source level" />
                                    <CheckBox Grid.Row="0" Grid.Column="2" Content="Mute" IsChecked="{Binding PrimaryMuted}" />

                                    <local:LevelMeterControl Grid.Row="1" Grid.Column="1" Height="10" Margin="8,4,8,10"
                                                             ShowScale="False"
                                                             PeakDbLeft="{Binding PrimaryPeakDb}"
                                                             PeakDbRight="{Binding PrimaryPeakDb}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Second source"
                                               Width="112" TextTrimming="CharacterEllipsis" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-40" Maximum="12" Margin="8,0,8,0"
                                            Value="{Binding SecondaryGainDb, Delay=40}" VerticalAlignment="Center"
                                            AutomationProperties.Name="Second source level" />
                                    <CheckBox Grid.Row="2" Grid.Column="2" Content="Mute" IsChecked="{Binding SecondaryMuted}" />

                                    <local:LevelMeterControl Grid.Row="3" Grid.Column="1" Height="10" Margin="8,4,8,0"
                                                             ShowScale="False"
                                                             PeakDbLeft="{Binding SecondaryPeakDb}"
                                                             PeakDbRight="{Binding SecondaryPeakDb}" />
                                </Grid>

                                <TextBlock Text="{Binding MixHint}" Style="{StaticResource HintStyle}" Margin="0,12,0,0"
                                           Visibility="{Binding MixHint, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== 2. PROCESS -->
            <TabItem Header="Process" Tag="◎">
                <ScrollViewer Style="{StaticResource PaneScrollStyle}">
                    <StackPanel Style="{StaticResource PaneBodyStyle}">

                        <TextBlock Text="Process" Style="{StaticResource PaneHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,4"
                                   Text="Shaping and measurement. Everything here is optional — a show sounds fine with all of it left alone." />

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,14,0,0">
                            <TextBlock Text="C O M P R E S S I O N" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Evening out the dynamics" ContentWidth="330" ShowRule="False"
                                              Hint="{Binding ProcessingDescription}">
                                <ComboBox ItemsSource="{Binding ProcessingPresetNames}"
                                          SelectedItem="{Binding SelectedProcessingPresetName}"
                                          AutomationProperties.Name="Compression preset" />
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="T O N E" Style="{StaticResource GroupHeadingStyle}" />

                            <!--
                                Three rows rather than a grid, unlike the mixer's faders. Bass, middle
                                and treble are three independent settings that happen to look alike -
                                there is no second axis - so they belong in the same list as everything
                                else. The mixer is a table because a source has a level *and* a mute.
                            -->
                            <local:SettingRow Label="Bass" ContentWidth="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-12" Maximum="12" Value="{Binding ToneLowDb, Delay=40}"
                                            VerticalAlignment="Center" AutomationProperties.Name="Bass" />
                                    <TextBlock Grid.Column="1" Text="{Binding ToneLowText}" Width="56"
                                               TextAlignment="Right" FontFamily="Consolas" FontSize="11" />
                                </Grid>
                            </local:SettingRow>

                            <local:SettingRow Label="Middle" ContentWidth="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-12" Maximum="12" Value="{Binding ToneMidDb, Delay=40}"
                                            VerticalAlignment="Center" AutomationProperties.Name="Middle" />
                                    <TextBlock Grid.Column="1" Text="{Binding ToneMidText}" Width="56"
                                               TextAlignment="Right" FontFamily="Consolas" FontSize="11" />
                                </Grid>
                            </local:SettingRow>

                            <local:SettingRow Label="Treble" ContentWidth="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-12" Maximum="12" Value="{Binding ToneHighDb, Delay=40}"
                                            VerticalAlignment="Center" AutomationProperties.Name="Treble" />
                                    <TextBlock Grid.Column="1" Text="{Binding ToneHighText}" Width="56"
                                               TextAlignment="Right" FontFamily="Consolas" FontSize="11" />
                                </Grid>
                            </local:SettingRow>

                            <local:SettingRow Label="Start over" ContentWidth="200" ShowRule="False"
                                              Hint="Puts bass, middle and treble back to flat.">
                                <Button Content="Back to flat" Command="{Binding ResetToneCommand}"
                                        Style="{StaticResource RowButtonStyle}" MinWidth="130"
                                        HorizontalAlignment="Right" />
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="H O W   L O U D   I T   F E E L S" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Target" ContentWidth="330"
                                              Hint="{Binding LoudnessTargetDetail}">
                                <ComboBox ItemsSource="{Binding LoudnessTargetNames}"
                                          SelectedItem="{Binding SelectedLoudnessTargetName}"
                                          AutomationProperties.Name="Loudness target" />
                            </local:SettingRow>

                            <local:SettingRow Label="Measuring" ContentWidth="330" ShowRule="False"
                                              Hint="{Binding LoudnessVerdict}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Right now" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding ShortTermLoudnessText}" FontFamily="Consolas"
                                                   FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Whole show" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding IntegratedLoudnessText}" FontFamily="Consolas"
                                                   FontSize="16" Foreground="{Binding LoudnessBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Start again"
                                            Command="{Binding ResetLoudnessCommand}"
                                            Style="{StaticResource RowButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            ToolTip="Measures the whole-show figure again from now." />
                                </Grid>
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,22,0,8">
                            <TextBlock Text="S P E C T R U M   A N D   P H A S E" Style="{StaticResource GroupHeadingStyle}" />

                            <!-- Still behind a switch even on its own pane: reading it takes a lock
                                 the audio thread wants, and most shows never need it. -->
                            <local:SettingRow Label="Show frequencies and stereo phase" ContentWidth="38"
                                              ShowRule="{Binding ShowAdvancedMeters}"
                                              Hint="For checking a wiring fault or a heavy-handed EQ. Not needed for a normal show.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ShowAdvancedMeters}"
                                          AutomationProperties.Name="Show frequencies and stereo phase" />
                            </local:SettingRow>

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding ShowAdvancedMeters, Converter={StaticResource BoolToVisibility}}">
                                <local:SpectrumControl Height="110"
                                                       Bars="{Binding SpectrumBars}"
                                                       EdgesHz="{Binding SpectrumEdgesHz}" />

                                <TextBlock Text="S T E R E O   P H A S E" Style="{StaticResource MicroLabelStyle}"
                                           Margin="0,16,0,0" />
                                <TextBlock Text="{Binding CorrelationText}" FontFamily="Consolas" FontSize="15"
                                           Foreground="{Binding CorrelationBrush}" />
                                <TextBlock Text="{Binding CorrelationVerdict}" Style="{StaticResource HintStyle}"
                                           Foreground="{Binding CorrelationBrush}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== 3. SERVERS -->
            <TabItem Header="Servers" Tag="◈">
                <ScrollViewer Style="{StaticResource PaneScrollStyle}">
                    <StackPanel Style="{StaticResource PaneBodyStyle}">

                        <TextBlock Text="Servers" Style="{StaticResource PaneHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,4"
                                   Text="Where the show goes. Paste the address your host gave you and Deck will work out the rest." />

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,14,0,0">
                            <TextBlock Text="T H I S   S H O W" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Server" ContentWidth="330"
                                              Hint="{Binding SelectedServerSummary}">
                                <ComboBox ItemsSource="{Binding Servers}"
                                          SelectedItem="{Binding SelectedServer}"
                                          ItemTemplate="{StaticResource NameItemTemplate}"
                                          AutomationProperties.Name="Server" />
                            </local:SettingRow>

                            <!--
                                A row with a readout instead of a control. The quality is not set
                                here - it belongs to the server and is changed behind Edit - but it is
                                the first thing anyone wants to confirm before going on air, and
                                making them open a dialog to read it would be worse than a row that
                                cannot be clicked.
                            -->
                            <local:SettingRow Label="Quality" ContentWidth="330">
                                <TextBlock Text="{Binding QualitySummary}" Style="{StaticResource ReadoutStyle}"
                                           TextAlignment="Right" TextWrapping="Wrap" />
                            </local:SettingRow>

                            <local:SettingRow Label="This server" ContentWidth="400" ShowRule="False"
                                              Hint="Duplicate is the quickest way to add a backup.">
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Add…" Click="OnAddServer"
                                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="80" />
                                    <Button Content="Edit…" Click="OnEditServer"
                                            Style="{StaticResource RowButtonStyle}" />
                                    <Button Content="Duplicate" Click="OnDuplicateServer"
                                            Style="{StaticResource RowButtonStyle}" />
                                    <Button Content="Delete" Click="OnDeleteServer"
                                            Style="{StaticResource RowButtonStyle}" />
                                </WrapPanel>
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="C H E C K I N G   A N D   S H A R I N G" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Listen to my stream" ContentWidth="200"
                                              Hint="Opens your stream in your usual player, so you can hear it end to end."
                                              Visibility="{Binding ListenUrl, Converter={StaticResource TextToVisibility}}">
                                <Button Content="Listen" Click="OnListen"
                                        Style="{StaticResource RowButtonStyle}" MinWidth="110"
                                        HorizontalAlignment="Right" />
                            </local:SettingRow>

                            <local:SettingRow Label="These settings" ContentWidth="240" ShowRule="False"
                                              Hint="Passwords are deliberately left out of a shared file.">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Share…" Click="OnExportServers"
                                            Style="{StaticResource RowButtonStyle}" MinWidth="100" />
                                    <Button Content="Import…" Click="OnImportServers"
                                            Style="{StaticResource RowButtonStyle}" MinWidth="100" />
                                </StackPanel>
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="B A C K U P   S E R V E R S" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Also send to another server" ContentWidth="38"
                                              ShowRule="{Binding SendToMoreThanOneServer}"
                                              Hint="Run a backup relay, or the same show at a second bitrate. One dropping does not take the others off air.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding SendToMoreThanOneServer}"
                                          AutomationProperties.Name="Also send to another server" />
                            </local:SettingRow>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding SendToMoreThanOneServer, Converter={StaticResource BoolToVisibility}}">
                                <!--
                                    Not rows. This is a list of things ticked, where the number of
                                    entries depends on how many servers exist - so it is one item per
                                    saved server rather than one setting per line.
                                -->
                                <ItemsControl ItemsSource="{Binding ExtraTargets}"
                                              Visibility="{Binding HasOtherServers, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Detail}" Margin="10,0,0,0" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding ExtraTargetsHint}" Style="{StaticResource HintStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- One line per destination, so a failing backup is visible but not alarming. -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding ShowTargetStatus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding BroadcastDetail}" Style="{StaticResource HintStyle}"
                                           Margin="0,0,0,8" />

                                <ItemsControl ItemsSource="{Binding TargetStatus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{Binding StateBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding ConnectionStats}" Style="{StaticResource HintStyle}"
                                           Foreground="{Binding ConnectionStatsBrush}" Margin="0,10,0,0"
                                           FontFamily="Consolas" FontSize="11"
                                           Visibility="{Binding ConnectionStats, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,22,0,8">
                            <TextBlock Text="G O I N G   O N   A I R" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Go live when Deck starts" ContentWidth="38">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AutoConnectOnStart}"
                                          AutomationProperties.Name="Go live when Deck starts" />
                            </local:SettingRow>

                            <local:SettingRow Label="Go live when it hears sound" ContentWidth="38" ShowRule="False"
                                              Hint="{Binding AutoAirStatus}">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AutoGoLiveOnSound}"
                                          AutomationProperties.Name="Go live when it hears sound" />
                            </local:SettingRow>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== 4. TRACK -->
            <TabItem Header="Track" Tag="♪">
                <ScrollViewer Style="{StaticResource PaneScrollStyle}">
                    <StackPanel Style="{StaticResource PaneBodyStyle}">

                        <TextBlock Text="Track" Style="{StaticResource PaneHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,4"
                                   Text="What listeners see as now playing, and where that text comes from." />

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,14,0,0">
                            <TextBlock Text="N O W   P L A Y I N G" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Title" ContentWidth="330"
                                              Hint="{Binding NowPlayingStatus}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NowPlayingInput, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding UsingTextFileMetadata, Converter={StaticResource InverseBoolean}, Mode=OneWay}"
                                             KeyDown="OnNowPlayingKeyDown"
                                             AutomationProperties.Name="Now playing title" />
                                    <Button Grid.Column="1" Content="Send"
                                            Command="{Binding UpdateNowPlayingCommand}"
                                            Style="{StaticResource RowButtonStyle}" />
                                </Grid>
                            </local:SettingRow>

                            <local:SettingRow Label="Where titles come from" ContentWidth="330"
                                              Hint="Deck can follow whatever Windows is playing, or read a file your playout software writes.">
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Windows" Click="OnUseMediaSession"
                                            Style="{StaticResource RowButtonStyle}"
                                            ToolTip="Pick up titles automatically from Spotify, your browser, or any player." />
                                    <Button Content="A file…" Click="OnChooseMetadataFile"
                                            Style="{StaticResource RowButtonStyle}"
                                            ToolTip="Point Deck at the file your playout software updates on each track." />
                                    <Button Content="Type it myself" Click="OnUseManualMetadata"
                                            Style="{StaticResource RowButtonStyle}"
                                            Visibility="{Binding UsingTextFileMetadata, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                            </local:SettingRow>

                            <local:SettingRow Label="Hold the current title" ContentWidth="38" ShowRule="False"
                                              Hint="For adverts and jingles: listeners keep seeing the last track until you turn this off.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding HoldNowPlaying}"
                                          AutomationProperties.Name="Hold the current title" />
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="T I T L E   F O R M A T" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Format" ContentWidth="330" ShowRule="False"
                                              Hint="{Binding TitleTemplatePreview}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TitleTemplateText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                             AutomationProperties.Name="Title format" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TitleTemplateExamples}"
                                              SelectedItem="{Binding TitleTemplateText}" Width="118" Margin="8,0,0,0"
                                              AutomationProperties.Name="Common formats"
                                              ToolTip="Common formats." />
                                </Grid>
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,22,0,8">
                            <TextBlock Text="A U T O M A T I O N" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Let my playout software send titles" ContentWidth="38"
                                              ShowRule="{Binding ShowMetadataEndpointDetails}"
                                              Hint="{Binding MetadataEndpointStatus}">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding MetadataEndpointEnabled}"
                                          AutomationProperties.Name="Let my playout software send titles" />
                            </local:SettingRow>

                            <StackPanel Visibility="{Binding ShowMetadataEndpointDetails, Converter={StaticResource BoolToVisibility}}">
                                <local:SettingRow Label="Port" ContentWidth="330">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding MetadataPort, Delay=500}"
                                                 AutomationProperties.Name="Port" />
                                        <Button Grid.Column="1" Content="Copy the address"
                                                Command="{Binding CopyEndpointUrlCommand}"
                                                Style="{StaticResource RowButtonStyle}"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                </local:SettingRow>

                                <local:SettingRow Label="Allow other computers" ContentWidth="38"
                                                  Hint="Off means this computer only, which is what almost everyone wants.">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding MetadataAllowOtherComputers}"
                                              AutomationProperties.Name="Allow other computers to send titles" />
                                </local:SettingRow>

                                <local:SettingRow Label="Password" ContentWidth="330" ShowRule="False"
                                                  Hint="Required before Deck will accept titles from another computer.">
                                    <TextBox Text="{Binding MetadataToken, Delay=500}"
                                             AutomationProperties.Name="Endpoint password" />
                                </local:SettingRow>

                                <TextBlock Text="{Binding MetadataEndpointUrl}" Style="{StaticResource HintStyle}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== 5. RECORD -->
            <TabItem Header="Record" Tag="●">
                <ScrollViewer Style="{StaticResource PaneScrollStyle}">
                    <StackPanel Style="{StaticResource PaneBodyStyle}">

                        <!--
                            No readout beside the heading. The rail panes used to carry one - "recording
                            · 04:12" here, the loudness target on Sound - to answer the question you
                            would otherwise change pane to ask. On The Deck that question is already
                            answered twice over, by the deck itself and by the strip along the bottom.
                            Setup configures; the deck reports. Keeping both would be stating the same
                            fact in two places on one screen.
                        -->
                        <TextBlock Text="Record" Style="{StaticResource PaneHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,4"
                                   Text="Keep a copy while you broadcast, or use Deck as a plain recorder with no server at all." />

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,14,0,8">
                            <local:SettingRow Label="Recording" ContentWidth="330"
                                              Hint="{Binding RecordingStatus}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding RecordButtonText}" Click="OnToggleRecording"
                                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" />
                                    <Button Content="Folder…" Click="OnChooseRecordingFolder"
                                            Style="{StaticResource RowButtonStyle}"
                                            ToolTip="Choose where recordings are saved." />
                                    <Button Content="Open" Click="OnOpenRecordingFolder"
                                            Style="{StaticResource RowButtonStyle}"
                                            ToolTip="Open the recordings folder." />
                                </StackPanel>
                            </local:SettingRow>

                            <local:SettingRow Label="Record every show" ContentWidth="38"
                                              Hint="{Binding RecordEveryShowHint}">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding RecordEveryShow}"
                                          AutomationProperties.Name="Record every show" />
                            </local:SettingRow>

                            <local:SettingRow Label="Saved as" ContentWidth="330"
                                              Hint="What the file is, independently of what goes out to listeners.">
                                <ComboBox ItemsSource="{Binding RecordingFormatLabels}"
                                          SelectedItem="{Binding SelectedRecordingFormatLabel}"
                                          AutomationProperties.Name="Recording format" />
                            </local:SettingRow>

                            <local:SettingRow Label="Split into files" ContentWidth="330" ShowRule="False"
                                              Hint="Long shows are easier to handle as several files than as one.">
                                <ComboBox ItemsSource="{Binding SplitLabels}"
                                          SelectedItem="{Binding SelectedSplitLabel}"
                                          AutomationProperties.Name="Split recordings into files" />
                            </local:SettingRow>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== 6. CONTROL -->
            <TabItem Header="Control" Tag="⌘">
                <ScrollViewer Style="{StaticResource PaneScrollStyle}">
                    <StackPanel Style="{StaticResource PaneBodyStyle}">

                        <TextBlock Text="Control" Style="{StaticResource PaneHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,4"
                                   Text="Ways to drive Deck without clicking: a keyboard shortcut, a physical button, or another program entirely." />

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,14,0,0">
                            <TextBlock Text="K E Y B O A R D   A N D   T R A Y" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Shortcuts" ContentWidth="330">
                                <TextBlock Text="{Binding HotkeyDescription}" Style="{StaticResource ReadoutStyle}"
                                           TextAlignment="Right" TextWrapping="Wrap" />
                            </local:SettingRow>

                            <local:SettingRow Label="Keep Deck in the notification area" ContentWidth="38"
                                              ShowRule="False"
                                              Hint="When minimised, Deck sits by the clock instead of on the taskbar.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding MinimiseToTray}"
                                          AutomationProperties.Name="Keep Deck in the notification area" />
                            </local:SettingRow>
                        </StackPanel>

                        <!-- Below the harmless things on purpose: this is the one switch here that
                             lets something outside Deck take the station on air. -->
                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="R E M O T E   C O N T R O L" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Let other programs control Deck" ContentWidth="38"
                                              ShowRule="{Binding ShowControlEndpointDetails}"
                                              Hint="{Binding ControlEndpointStatus}">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ControlEndpointEnabled}"
                                          AutomationProperties.Name="Let other programs control Deck" />
                            </local:SettingRow>

                            <TextBlock Style="{StaticResource HintStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="This is how Deck --live works from a script or a scheduled task." />

                            <StackPanel Visibility="{Binding ShowControlEndpointDetails, Converter={StaticResource BoolToVisibility}}">
                                <local:SettingRow Label="Port" ContentWidth="330">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ControlPort, Delay=500}"
                                                 AutomationProperties.Name="Control port" />
                                        <Button Grid.Column="1" Content="Copy the address"
                                                Command="{Binding CopyControlUrlCommand}"
                                                Style="{StaticResource RowButtonStyle}"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                </local:SettingRow>

                                <local:SettingRow Label="Allow other computers" ContentWidth="38"
                                                  Hint="Off means this computer only. Anything on your network could otherwise put your station on air.">
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ControlAllowOtherComputers}"
                                              AutomationProperties.Name="Allow other computers to control Deck" />
                                </local:SettingRow>

                                <local:SettingRow Label="Password" ContentWidth="330" ShowRule="False"
                                                  Hint="Required before Deck will take a command from another computer.">
                                    <TextBox Text="{Binding ControlToken, Delay=500}"
                                             AutomationProperties.Name="Control password" />
                                </local:SettingRow>

                                <TextBlock Text="{Binding ControlEndpointUrl}" Style="{StaticResource HintStyle}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,22,0,8">
                            <TextBlock Text="M I D I   C O N T R O L L E R" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Controller" ContentWidth="330"
                                              Hint="{Binding MidiStatus}">
                                <ComboBox ItemsSource="{Binding MidiDevices}"
                                          SelectedItem="{Binding SelectedMidiDevice}"
                                          AutomationProperties.Name="MIDI controller"
                                          ToolTip="A control surface, keyboard or mixer that sends MIDI." />
                            </local:SettingRow>

                            <!--
                                The bindings were already row-shaped - a name, what it is wired to,
                                and two buttons - so they become actual rows rather than a lookalike
                                grid. One template, so a binding row and a setting row cannot drift
                                apart in spacing or rule weight.
                            -->
                            <ItemsControl ItemsSource="{Binding MidiBindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:SettingRow Label="{Binding Label}" Hint="{Binding Assignment}"
                                                          ContentWidth="150">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Learn" MinWidth="64"
                                                        Command="{Binding LearnCommand}"
                                                        Style="{StaticResource RowButtonStyle}" />
                                                <Button Content="Clear" MinWidth="64"
                                                        Command="{Binding ClearCommand}"
                                                        Style="{StaticResource RowButtonStyle}"
                                                        Visibility="{Binding HasAssignment, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </local:SettingRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Stop waiting" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding CancelMidiLearnCommand}"
                                    Visibility="{Binding IsLearningMidi, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== 7. Deck -->
            <TabItem Header="Deck" Tag="⚙">
                <ScrollViewer Style="{StaticResource PaneScrollStyle}">
                    <StackPanel Style="{StaticResource PaneBodyStyle}">

                        <TextBlock Text="Deck itself" Style="{StaticResource PaneHeadingStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,4"
                                   Text="Set once and forget. Nothing here affects what goes out." />

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,14,0,0">
                            <TextBlock Text="A P P E A R A N C E" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Palette" ContentWidth="330" ShowRule="False"
                                              Hint="{Binding ThemeHint}">
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          AutomationProperties.Name="Palette" />
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="L A N G U A G E" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Language" ContentWidth="330"
                                              Hint="{Binding LanguageHint}">
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          AutomationProperties.Name="Language" />
                            </local:SettingRow>

                            <local:SettingRow Label="Translating Deck" ContentWidth="240" ShowRule="False"
                                              Hint="Saves the English text as a file you can translate and drop back in.">
                                <Button Content="Save the English…" Click="OnExportLanguage"
                                        Style="{StaticResource RowButtonStyle}" MinWidth="160"
                                        HorizontalAlignment="Right" />
                            </local:SettingRow>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}">
                            <TextBlock Text="V E R S I O N" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="{Binding VersionText}" ContentWidth="330"
                                              Hint="{Binding UpdateStatus}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Check now" Command="{Binding CheckUpdatesCommand}"
                                            Style="{StaticResource RowButtonStyle}" MinWidth="110" />
                                    <Button Content="Release page" Command="{Binding OpenReleasePageCommand}"
                                            Style="{StaticResource RowButtonStyle}" MinWidth="120" />
                                </StackPanel>
                            </local:SettingRow>

                            <local:SettingRow Label="Check for updates automatically" ContentWidth="38"
                                              ShowRule="{Binding UpdateAvailable}"
                                              Hint="Off by default: a check tells GitHub that this computer is running Deck.">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding CheckForUpdates}"
                                          AutomationProperties.Name="Check for updates automatically" />
                            </local:SettingRow>

                            <!-- Installing is a separate, deliberate click. It appears only once there
                                 is something to install and Deck can write to its own folder. -->
                            <StackPanel Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                                <local:SettingRow Label="Install it" ContentWidth="240" ShowRule="False"
                                                  Hint="Deck downloads the new version, checks it against the checksum published beside it, closes itself and starts the new one. Your settings and servers are left alone.">
                                    <Button Content="{Binding InstallUpdateButtonText}"
                                            Command="{Binding InstallUpdateCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            IsEnabled="{Binding CanInstallUpdate}"
                                            HorizontalAlignment="Right" MinWidth="180" />
                                </local:SettingRow>

                                <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                             Value="{Binding UpdateProgressFraction, Mode=OneWay}"
                                             Visibility="{Binding IsInstallingUpdate, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource HintStyle}" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="Updates come only from the Deck releases on GitHub, over https, and are refused if the download does not match its published checksum." />
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingGroupStyle}" Margin="0,22,0,8">
                            <TextBlock Text="T H I S   S E S S I O N" Style="{StaticResource GroupHeadingStyle}" />

                            <local:SettingRow Label="Session log" ContentWidth="200" ShowRule="False"
                                              Hint="Connects, drops, device trouble and track changes. The same entries are appended to a file in the logs folder.">
                                <Button Content="Open the log" Click="OnOpenLog"
                                        Style="{StaticResource RowButtonStyle}" MinWidth="130"
                                        HorizontalAlignment="Right" />
                            </local:SettingRow>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================================================== status strip

             Present only while setup is covering the deck. The deck carries its own state in far
             larger type, so showing both at once would say the same thing twice on one screen — but
             the moment the deck is hidden, something has to keep answering "am I still live?", and
             this is it. Exactly one of the two is always on screen. -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,9"
                Visibility="{Binding ShowStatusStrip, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Square, not a rounded pill: the state block is signage. The pill shape is
                         reserved for the level verdict, so the two never read as the same thing. -->
                    <Border Background="{Binding StateBrush}" Padding="11,4">
                        <TextBlock Text="{Binding StateHeadlineUpper}" Foreground="White"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" />
                    </Border>
                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource StatusValueStyle}"
                               Margin="14,0,18,0" />

                    <!-- Where it is going, who is listening, and in what. The mockup's strip reads
                         "Main + 1 backup · 42 listeners · MP3 256k", and all three are things
                         you should never have to change pane to check while on air.

                         The quality is the short form, not the sentence from the Servers pane. An
                         earlier attempt put the full summary here and it read as the same setting
                         twice on one screen; "MP3 256k" is a fact about what is going out. -->
                    <TextBlock Text="{Binding BroadcastTargetText}" Style="{StaticResource StatusChipStyle}"
                               MaxWidth="220" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding BroadcastTargetText}"
                               Visibility="{Binding BroadcastTargetText, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding ListenerText}" Style="{StaticResource StatusChipStyle}"
                               ToolTip="{Binding ListenerTooltip}"
                               Visibility="{Binding ListenerText, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding QualityShort}" Style="{StaticResource StatusChipStyle}"
                               ToolTip="{Binding QualitySummary}"
                               Visibility="{Binding QualityShort, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding SentText}" Style="{StaticResource StatusChipStyle}" />
                </StackPanel>

                <!-- The middle column carries whatever is currently wrong. Dead air is the loudest
                     thing Deck can say, so it gets the colour and the others do not. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="{Binding SilenceAlert}" Foreground="{DynamicResource BadBrush}"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="11.5"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SilenceAlert, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusChipStyle}"
                               Margin="0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The way out of setup. It lives here rather than in a header of its own,
                         beside the other things on screen that are meant to be pressed. -->
                    <Button Content="◀ Deck" Command="{Binding CloseSetupCommand}" Margin="0,0,8,0"
                            Style="{StaticResource StripButtonStyle}"
                            ToolTip="Back to the deck." />

                    <Button Content="Log" Click="OnOpenLog" Margin="0,0,8,0"
                            Style="{StaticResource StripButtonStyle}"
                            ToolTip="What Deck has done this session." />

                    <!--
                        Outlined while live, filled while off air, and that asymmetry is deliberate
                        rather than a compromise. Going on air should be an inviting target; taking a
                        station off air should not be something the hand finds by accident. The
                        mockup only ever drew the live state, where it is outlined.
                    -->
                    <Button Content="{Binding GoLiveButtonText}" Click="OnToggleBroadcast"
                            Style="{StaticResource StripButtonStyle}" MinWidth="180"
                            Background="{Binding GoLiveButtonBrush}"
                            Foreground="{Binding GoLiveButtonTextBrush}"
                            BorderBrush="{Binding GoLiveButtonBorderBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
